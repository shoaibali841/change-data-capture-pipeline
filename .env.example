
# ==========================================
# Application Configuration
# ==========================================
APP_NAME=cdc_pipeline
APP_ENV=development
LOG_LEVEL=INFO

# ==========================================
# PostgreSQL Configuration
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cdc_db
DB_USER=cdc_user
DB_PASSWORD=your_local_database_password

# ==========================================
# Test & Benchmark PostgreSQL Configuration
# ==========================================
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=cdc_test_db
TEST_DB_USER=cdc_user
TEST_DB_PASSWORD=your_local_test_database_password
# ==========================================
# Database Connection Pool
# ==========================================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ==========================================
# Pipeline Configuration
# ==========================================
BATCH_SIZE=1000
RANDOM_SEED=42

# ==========================================
# Data Directories
# ==========================================
INPUT_DATA_DIR=data/input
PROCESSED_DATA_DIR=data/processed
QUARANTINE_DATA_DIR=data/quarantine
LOG_DIR=logs
